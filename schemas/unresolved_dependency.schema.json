{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/human-resources-daemon/schemas/unresolved_dependency.schema.json",
  "title": "Unresolved Dependency",
  "description": "A blocking gap: missing information, an unresolved handoff, or an outstanding decision, with an explicit owner.",
  "type": "object",
  "required": ["dependency_id", "case_id", "description", "blocking", "owner_role", "opened_at", "status"],
  "properties": {
    "dependency_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "blocking": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "What this dependency blocks (e.g. 'case_resolution', 'payment_issuance')."
    },
    "owner_role": {
      "type": "string",
      "minLength": 1,
      "description": "The responsible human authority for resolving this dependency."
    },
    "opened_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["open", "resolved"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
