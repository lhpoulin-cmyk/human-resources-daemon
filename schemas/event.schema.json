{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/human-resources-daemon/schemas/event.schema.json",
  "title": "Event",
  "description": "A normalized, chronologically placed occurrence derived from evidence. An event describes what happened, not what it means.",
  "type": "object",
  "required": ["event_id", "case_id", "kind", "occurred_at", "evidence_refs"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": [
        "communication_sent",
        "communication_received",
        "meeting",
        "deadline",
        "status_change",
        "other"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": ["string", "null"]},
    "summary": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every event must trace to at least one evidence item."
    }
  },
  "additionalProperties": false
}
